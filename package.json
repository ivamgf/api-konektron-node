{
  "name": "konektron-api",
  "version": "5.1.0",
  "description": "API do sistema KonekTron - Engenharia de Software e Análise de Dados",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#database/*": "./src/database/*",
    "#middlewares/*": "./src/middlewares/*",
    "#modules/*": "./src/modules/*",
    "#services/*": "./src/services/*",
    "#shared/*": "./src/shared/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "knex migrate:latest && node src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make",
    "db:check": "node scripts/db-check.js",
    "db:tunnel": "node scripts/db-tunnel.js",
    "mail:test": "node scripts/mail-check.js",
    "seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "swagger-ui-dist": "5.33.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0"
  }
}
