# Ambiente: development | homologation | production  (RNF7)
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug
APP_URL=http://localhost:5173
API_URL=http://localhost:3333

# PostgreSQL: use DATABASE_URL (formato do painel de hospedagem) OU as variáveis DB_* abaixo.
# DATABASE_URL tem prioridade; o SSL vai na própria URL (?sslmode=disable | require).
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konektron_dev
DB_USER=konektron
DB_PASSWORD=troque_esta_senha
DB_SSL=false

# Túnel SSH até o banco do EasyPanel (npm run db:tunnel)
SSH_HOST=
SSH_USER=root
SSH_PORT=22
DB_CONTAINER=konektron_konektron_database
TUNNEL_PORT=5433

# JWT  (gere com: openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# E-mail (Titan, do domínio orkneytech-lab.com). Sem SMTP_HOST, os e-mails só aparecem no log.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=konektron@orkneytech-lab.com
SMTP_PASSWORD=
MAIL_FROM="KonekTron <konektron@orkneytech-lab.com>"
# Para onde vão as mensagens do formulário de contato (vazio = só ficam no banco, visíveis ao admin)
CONTACT_EMAIL=konektron@orkneytech-lab.com

# PagBank — assinaturas pelo Checkout Recorrente (sem PAGBANK_TOKEN, a venda de planos fica desligada)
# Token em Minha Conta > Integrações (sandbox e produção têm tokens diferentes).
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
# Mensalidade de cada plano em centavos (4990 = R$ 49,90). Vazio = plano não vendido.
PLAN_PRICE_STANDARD=
PLAN_PRICE_MASTER=
# Depois de configurar, cadastre a URL dos avisos de assinatura: npm run pagbank:webhook

# CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5173

# Documentação em /api/v1/docs (false desliga a página e o openapi.json)
DOCS_ENABLED=true

# Seeds (somente desenvolvimento/homologação)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
