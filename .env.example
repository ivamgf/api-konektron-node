# Ambiente: development | homologation | production  (RNF7)
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug
APP_URL=http://localhost:5173
API_URL=http://localhost:3333

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konektron_dev
DB_USER=konektron
DB_PASSWORD=troque_esta_senha
DB_SSL=false

# JWT  (gere com: openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# E-mail (SMTP da HostGator ou outro). Sem SMTP_HOST, os e-mails só aparecem no log.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="KonekTron <no-reply@seudominio.com.br>"

# CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5173

# Seeds (somente desenvolvimento/homologação)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
